# Processado pelo entrypoint do nginx a cada start: ${API_URL} é substituído
# pela variável de ambiente do container. É o que permite trocar o destino da API
# sem rebuild da imagem — necessário quando front e API são serviços separados e
# o nome do container não é previsível.
#
# NGINX_ENVSUBST_FILTER limita a substituição a API_URL; sem isso o envsubst
# comeria $host, $uri e companhia, que são variáveis do próprio nginx.
server {
  listen 3000;
  root /usr/share/nginx/html;
  index index.html;

  # Sem barra no fim do proxy_pass: o prefixo /api segue para a API, que serve
  # rotas em /api/v1/... Com barra, o prefixo seria removido e tudo daria 404.
  location /api/ {
    proxy_pass ${API_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    try_files $uri /index.html;
  }
}
